# Server Binding Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Optional API key for authenticating incoming requests
# If set, clients must pass `Authorization: Bearer <API_KEY>`
API_KEY=

# Antigravity CLI path (auto-detected if empty)
AGY_BIN_PATH=/Users/xm15118057/.local/bin/agy

# Default Model and Reasoning Effort
DEFAULT_MODEL=Gemini 3.7 Flash (High)
DEFAULT_EFFORT=high

# Execution permissions & commands
DANGEROUSLY_SKIP_PERMISSIONS=true
DISABLE_SLASH_COMMANDS=true

# Output formatting
INCLUDE_REASONING_CONTENT=true
EMBED_THINKING_IN_TEXT=false
